---
import Base from '../layouts/Base.astro';
import { animations } from '../animations';

// Server-side pick: no client script decides which animation you get, and the
// response is never cached, so every reload draws a different study.
Astro.response.headers.set('Cache-Control', 'no-store');

const previous = Astro.cookies.get('anim')?.value;
const pool = animations.length > 1 ? animations.filter((a) => a.id !== previous) : animations;
const pick = pool[Math.floor(Math.random() * pool.length)] ?? animations[0];

Astro.cookies.set('anim', pick.id, {
  path: '/',
  sameSite: 'lax',
  maxAge: 60 * 60 * 24 * 365,
});

const Animation = pick.Component;
---
<Base animation={pick.id}>
  <main>
    <header class="hero">
      <h1 class="hero-title">
        <span class="hello">Hi, I'm</span>
        <span class="name">
          <span class="sr-only">Sahas</span>
          <span aria-hidden="true"><Animation /></span>
        </span>
      </h1>
      <p class="tagline">The full site is coming — reload for a different animation!</p>
    </header>

    <section class="content">
      <p>
        Well, I kinda need a good idea for the site so if you have any ideas, or just anything at
        all please contact me below or at sahas {at} shimpi {dot} dev (written that way so that the
        spam bots don't add my email to some list)
      </p>

      <form class="contact" method="post" action="/api/contact" data-contact>
        <div class="field">
          <label for="c-name">Name</label>
          <input id="c-name" name="name" type="text" autocomplete="name" required maxlength="80" />
        </div>
        <div class="field">
          <label for="c-email">Email</label>
          <input id="c-email" name="email" type="email" autocomplete="email" required maxlength="160" />
        </div>
        <div class="field">
          <label for="c-message">Message</label>
          <textarea id="c-message" name="message" rows="4" required maxlength="4000"></textarea>
        </div>
        <div class="honeypot" aria-hidden="true">
          <label for="c-website">Website</label>
          <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit">Send message</button>
        <p class="form-status" data-status role="status" aria-live="polite"></p>
      </form>

      <p>Till the time, sign up to our newsletter!</p>

      <div class="newsletter">
        <form class="contact" method="post" action="/api/subscribe" data-subscribe>
          <div class="field">
            <label for="n-email">Email</label>
            <input
              id="n-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="you@example.com"
              required
              maxlength="160"
            />
          </div>
          <div class="honeypot" aria-hidden="true">
            <label for="n-website">Website</label>
            <input id="n-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <button type="submit">Subscribe</button>
          <p class="form-status" data-subscribe-status role="status" aria-live="polite"></p>
        </form>
      </div>

      <p class="note">
        For a small surprise, make sure to check out the Console! (no, there's no console game yet but i
        may or may not add it in the future...)
      </p>
    </section>
  </main>

  <script>
    import '../scripts/animations.js';
  </script>

  <script is:inline>
    const form = document.querySelector('[data-contact]');
    if (form) {
      const status = form.querySelector('[data-status]');
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = 'Sending…';
        const payload = Object.fromEntries(new FormData(form));
        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const body = await res.json().catch(() => ({}));
          if (res.ok && body.ok) {
            form.reset();
            status.textContent = 'Thanks — message sent.';
          } else if (body.error === 'not_configured') {
            status.textContent = 'The contact form is not set up yet.';
          } else {
            status.textContent = body.error || 'Something went wrong — try again?';
          }
        } catch (error) {
          status.textContent = 'Could not reach the server — try again?';
        }
      });
    }

    const subscribe = document.querySelector('[data-subscribe]');
    if (subscribe) {
      const status = subscribe.querySelector('[data-subscribe-status]');
      subscribe.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = 'Sending…';
        const payload = Object.fromEntries(new FormData(subscribe));
        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const body = await res.json().catch(() => ({}));
          if (res.ok && body.ok) {
            subscribe.reset();
            status.textContent = 'Check your inbox — CampaignLark sent a link to confirm.';
          } else if (body.error === 'not_configured') {
            status.textContent = 'The newsletter is not set up yet.';
          } else {
            status.textContent = body.error || 'Something went wrong — try again?';
          }
        } catch (error) {
          status.textContent = 'Could not reach the server — try again?';
        }
      });
    }

    const art = `░██     ░██            ░██ ░██            ░██
░██     ░██            ░██ ░██            ░██
░██     ░██  ░███████  ░██ ░██  ░███████  ░██
░██████████ ░██    ░██ ░██ ░██ ░██    ░██ ░██
░██     ░██ ░█████████ ░██ ░██ ░██    ░██ ░██
░██     ░██ ░██        ░██ ░██ ░██    ░██
░██     ░██  ░███████  ░██ ░██  ░███████  ░██`;
    const msg = 'Hey techie! Use the form on the page to say hi... i kinda need some motivation';
    const style = 'color:#00aaff;font-family:monospace;font-size:14px;font-weight:bold;';
    console.log(`%c${art}`, style);
    console.log(`%c${msg}`, style);
    console.log('%cHELLO', style);
  </script>

</Base>
