---
import Base from '../layouts/Base.astro';
import { animations } from '../animations';

// Server-side pick: no client script decides which animation you get, and the
// response is never cached, so every reload draws a different study.
Astro.response.headers.set('Cache-Control', 'no-store');

const previous = Astro.cookies.get('anim')?.value;
const pool = animations.length > 1 ? animations.filter((a) => a.id !== previous) : animations;
const pick = pool[Math.floor(Math.random() * pool.length)] ?? animations[0];

Astro.cookies.set('anim', pick.id, {
  path: '/',
  sameSite: 'lax',
  maxAge: 60 * 60 * 24 * 365,
});

const Animation = pick.Component;

// Public Turnstile key; its secret is checked on the server only.
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '0x4AAAAAAF52ej7obxMw90-T';
---
<Base animation={pick.id}>
  <main data-anim-total={animations.length}>
    <header class="hero">
      <h1 class="hero-title">
        <span class="hello">Hi, I'm</span>
        <span class="name">
          <span class="sr-only">Sahas</span>
          <span aria-hidden="true"><Animation /></span>
        </span>
      </h1>
      <p class="tagline">Reload for a different animation!</p>
    </header>

    <section class="content">
      <p>
        Well, I kinda need a good idea for the site so if you have any ideas, or just anything at
        all please contact me below or at <span class="mailto" data-mail>sahbasb shimpib debv</span>.
      </p>

      <form class="contact" method="post" action="/api/contact" data-contact>
        <div class="field">
          <label for="c-name">Name</label>
          <input id="c-name" name="name" type="text" autocomplete="name" required maxlength="80" />
        </div>
        <div class="field">
          <label for="c-email">Email</label>
          <input id="c-email" name="email" type="email" autocomplete="email" required maxlength="160" />
        </div>
        <div class="field">
          <label for="c-message">Message</label>
          <textarea id="c-message" name="message" rows="4" required maxlength="4000"></textarea>
        </div>
        <div class="honeypot" aria-hidden="true">
          <label for="c-website">Website</label>
          <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div
          class="turnstile"
          data-turnstile
          data-sitekey={TURNSTILE_SITE_KEY}
          data-action="contact"></div>
        <button type="submit" data-cta>
          <span class="cta-label">Send message</span>
          <span class="cta-icon" aria-hidden="true">
            <svg class="spin" viewBox="0 0 24 24" fill="none">
              <circle
                cx="12"
                cy="12"
                r="9"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-dasharray="15 42"></circle>
            </svg>
            <svg class="tick" viewBox="0 0 24 24" fill="none">
              <path
                d="M5 12.6l4.3 4.3L19 7.4"
                stroke="currentColor"
                stroke-width="2.8"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
        </button>
        <p class="form-status" data-status role="status" aria-live="polite"></p>
      </form>

      <p>Till the time, sign up to our newsletter!</p>

      <div class="newsletter">
        <form class="contact" method="post" action="/api/subscribe" data-subscribe>
          <div class="nrow">
            <div class="field">
              <label for="n-email">Email</label>
              <input
                id="n-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="you@example.com"
                required
                maxlength="160"
              />
            </div>
            <button type="submit" data-cta>
              <span class="cta-label">Subscribe</span>
              <span class="cta-icon" aria-hidden="true">
                <svg class="spin" viewBox="0 0 24 24" fill="none">
                  <circle
                    cx="12"
                    cy="12"
                    r="9"
                    stroke="currentColor"
                    stroke-width="2.6"
                    stroke-linecap="round"
                    stroke-dasharray="15 42"></circle>
                </svg>
                <svg class="tick" viewBox="0 0 24 24" fill="none">
                  <path
                    d="M5 12.6l4.3 4.3L19 7.4"
                    stroke="currentColor"
                    stroke-width="2.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
            </button>
          </div>
          <div class="honeypot" aria-hidden="true">
            <label for="n-website">Website</label>
            <input id="n-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div
            class="turnstile"
            data-turnstile
            data-sitekey={TURNSTILE_SITE_KEY}
            data-action="subscribe"></div>
          <p class="form-status" data-subscribe-status role="status" aria-live="polite"></p>
        </form>
      </div>

      <p class="note">
        For a small surprise, make sure to check out the Console! (no, there's no console game yet but i
        may or may not add it in the future...)
      </p>
    </section>
  </main>

  <script>
    import '../scripts/animations.js';
  </script>

  <script is:inline>
    // The address is scrambled in the HTML so scrapers get junk; it is decoded on
    // the first real interaction, before most people read past it.
    (() => {
      const address = document.querySelector('[data-mail]');
      if (!address) return;
      const decode = () => {
        address.textContent = address.textContent
          .replaceAll('b', '')
          .replace(' ', '@')
          .replaceAll(' ', '.');
      };
      const once = () => {
        decode();
        ['mouseenter', 'focus', 'click', 'touchstart', 'keydown'].forEach((type) =>
          document.removeEventListener(type, once, true)
        );
      };
      ['mouseenter', 'focus', 'click', 'touchstart', 'keydown'].forEach((type) =>
        document.addEventListener(type, once, true)
      );
    })();

    // Console: how many of the studies the visitor has seen. Only the count is
    // stored, never which one it was, so nothing gives the set away.
    (() => {
      const total = Number(document.querySelector('main')?.dataset.animTotal || 0);
      const current = document.querySelector('.anim[data-anim]')?.dataset.anim;
      let seen = [];
      try {
        seen = JSON.parse(localStorage.getItem('anim-seen') || '[]');
      } catch {
        seen = [];
      }
      if (!Array.isArray(seen)) seen = [];
      if (current && !seen.includes(current)) {
        seen.push(current);
        try {
          localStorage.setItem('anim-seen', JSON.stringify(seen));
        } catch {
          /* private mode: the count just won't persist */
        }
      }
      const count = Math.min(seen.length, total);
      console.log(
        `%c${count}/${total} animations seen!`,
        'color:#00aaff;font-family:monospace;font-size:14px;font-weight:bold;'
      );
    })();

    // Turnstile: the widget's token is sent with the payload and redeemed on the
    // server. Explicit rendering keeps a widget id so each form can reset its own.
    (() => {
      const widgets = new Map();

      function paint() {
        const nodes = Array.from(document.querySelectorAll('[data-turnstile]'));
        if (!nodes.length) return;
        if (!window.turnstile) {
          setTimeout(paint, 150);
          return;
        }
        nodes.forEach((el) => {
          if (el.dataset.widgetId) return;
          const id = window.turnstile.render(el, {
            sitekey: el.dataset.sitekey,
            action: el.dataset.action,
            theme: 'dark',
          });
          el.dataset.widgetId = String(id);
          widgets.set(el, String(id));
        });
      }
      paint();

      const reset = (form) => {
        const el = form.querySelector('[data-turnstile]');
        const id = el && el.dataset.widgetId;
        if (id) {
          try {
            window.turnstile.reset(id);
          } catch {
            /* the widget is gone or still loading */
          }
        }
      };

      async function submit(form, url, statusEl) {
        const button = form.querySelector('button[type="submit"]');
        const field = form.querySelector('.nrow .field');
        const token = form.querySelector('[name="cf-turnstile-response"]')?.value || '';
        if (!token) {
          statusEl.textContent = 'Just a moment — still checking that you are human…';
          return;
        }

        // Freeze the textbox width so the button shrinking to a dot can't stretch
        // it, and lock the button's own width so the morph can animate.
        if (field) field.style.flex = `0 0 ${field.getBoundingClientRect().width}px`;
        button.style.width = `${button.getBoundingClientRect().width}px`;
        button.dataset.state = 'loading';
        button.disabled = true;
        statusEl.textContent = '';

        const payload = Object.fromEntries(new FormData(form));
        try {
          const res = await fetch(url, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const body = await res.json().catch(() => ({}));
          if (res.ok && body.ok) {
            button.dataset.state = 'done';
            button.disabled = false;
            form.reset();
            setTimeout(() => reset(form), 600);
            return;
          }
          if (body.error === 'not_configured') throw new Error('This form is not set up yet.');
          throw new Error(body.error || 'Something went wrong — try again?');
        } catch (error) {
          button.dataset.state = '';
          button.style.width = '';
          button.disabled = false;
          if (field) field.style.flex = '';
          statusEl.textContent = error.message;
          reset(form);
        }
      }

      const wire = (selector, url, statusSelector) => {
        const form = document.querySelector(selector);
        if (!form) return;
        const statusEl = form.querySelector(statusSelector);
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          submit(form, url, statusEl);
        });
        // Editing again turns the finished tick back into a usable button.
        form.addEventListener('input', () => {
          const button = form.querySelector('button[type="submit"]');
          if (button && button.dataset.state === 'done') {
            button.dataset.state = '';
            button.style.width = '';
            statusEl.textContent = '';
          }
        });
      };

      wire('[data-contact]', '/api/contact', '[data-status]');
      wire('[data-subscribe]', '/api/subscribe', '[data-subscribe-status]');
    })();
  </script>
</Base>
