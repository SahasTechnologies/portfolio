---
// Pixel animation 07: Pulse.
// Extracted verbatim (SVG markup and CSS) from the "Sahas — animation studies" export.
// The play class starts the entrance animation; src/scripts/animations.js runs the interactivity.
---
<style is:global>
.pp{fill:var(--f);transform-box:fill-box;transform-origin:center;transition:transform .16s ease-out,fill .16s ease-out}
.pp.on{transform:scale(1.65);fill:#fff}
.play .pp{animation:ppin .7s var(--dl) backwards}
.play .pp.p1{animation:pulse .55s var(--pd) backwards}
.play .pp.p2{animation:pulse2 .55s var(--pd) backwards}
.pls{touch-action:pan-y;cursor:pointer}
@keyframes ppin{0%{transform:scale(0);fill:#fff}60%{transform:scale(1.3)}100%{transform:none}}
@keyframes pulse{0%{transform:none}40%{transform:scale(1.55);fill:#fff}100%{transform:none}}
@keyframes pulse2{0%{transform:none}40%{transform:scale(1.55);fill:#fff}100%{transform:none}}
</style>
<div class="anim play" data-anim="pls">
