---
// Pixel animation 02: Scatter.
// Extracted verbatim (SVG markup and CSS) from the "Sahas — animation studies" export.
// The play class starts the entrance animation; src/scripts/animations.js runs the interactivity.
---
<style is:global>
.gat{transform-box:fill-box;transform-origin:center}
.play .gat{animation:gather .9s var(--dl) cubic-bezier(.2,.8,.2,1) both}
.dp{transition:transform .3s cubic-bezier(.2,.8,.2,1)}
@keyframes gather{from{transform:translate(calc(var(--dx)*1px),calc(var(--dy)*1px)) scale(.2);opacity:0}to{transform:none;opacity:1}}
</style>
<div class="anim play" data-anim="scatter">
