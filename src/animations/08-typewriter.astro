---
// Pixel animation 08: Typewriter.
// Extracted verbatim (SVG markup and CSS) from the "Sahas — animation studies" export.
// The play class starts the entrance animation; src/scripts/animations.js runs the interactivity.
---
<style is:global>
.tw{fill:#f5f5f5;transition:opacity .08s}
.cur rect{fill:#4ade80}
.play .tw{animation:show .01s var(--dl) backwards}
.play .cur{animation:curmove 2.7s .1s steps(29) both,curhide .01s 2.85s forwards}
.tcar{fill:#4ade80;opacity:0}
@keyframes show{from{opacity:0}to{opacity:1}}
@keyframes curmove{from{transform:translateX(0)}to{transform:translateX(29px)}}
@keyframes curhide{to{opacity:0}}
</style>
