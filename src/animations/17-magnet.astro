<style is:global>
.mgs{touch-action:pan-y}
.mg{fill:var(--f)}
@keyframes ppin{0%{transform:scale(0);fill:#fff}60%{transform:scale(1.3)}100%{transform:none}}
.play .mg{animation:ppin .6s var(--dl) backwards}
</style>
