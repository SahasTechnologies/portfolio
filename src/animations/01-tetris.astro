.tc{transform-box:fill-box;transform-origin:center;transition:transform .3s cubic-bezier(.5,0,.8,.5),opacity .25s}
.tf{opacity:0}
.tf.fill{opacity:1}
.tc.clr{opacity:0;transform:scale(0)}
.tc.clr rect{fill:#fff}
@keyframes sx{from{transform:translateX(calc(var(--dx)*1px))}to{transform:none}}
@keyframes sy{from{transform:translateY(calc(var(--dy)*-1px))}to{transform:none}}
