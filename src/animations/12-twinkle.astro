---
// Pixel animation 12: Twinkle.
// Extracted verbatim (SVG markup and CSS) from the "Sahas — animation studies" export.
// The play class starts the entrance animation; src/scripts/animations.js runs the interactivity.
---
<style is:global>
.tkg{fill:#0d0d0d;transition:fill .9s}
.tkg:hover{fill:#fff;transition:fill 0s}
.tkb{animation:tkw var(--du) var(--dl) infinite}
.tkb:hover{animation:none}
.tkp{fill:var(--f);opacity:.28;animation:tkl var(--du) var(--dl) infinite}
.tkp:hover{animation:none;opacity:1}
.twk .ov{opacity:0;pointer-events:none}
.twk.go .ov{animation:flashall 1.2s calc(var(--x)*10ms) ease-out both}
.twk{cursor:pointer}
@keyframes tkw{0%,88%{fill:#0d0d0d}92%{fill:#fff}100%{fill:#0d0d0d}}
@keyframes tkl{0%,66%{opacity:.28}74%{opacity:1}86%{opacity:1}100%{opacity:.28}}
@keyframes flashall{0%{opacity:1}100%{opacity:0}}
</style>
<div class="anim play" data-anim="twinkle">
