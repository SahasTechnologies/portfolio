---
// Pixel animation 09: Pac-Man.
// Extracted verbatim (SVG markup and CSS) from the "Sahas — animation studies" export.
// The play class starts the entrance animation; src/scripts/animations.js runs the interactivity.
---
<style is:global>
.pmd{fill:#fde68a}
.pmn{fill:#f5f5f5;opacity:0}
.pco{animation:chomp .2s steps(1) infinite}
.pcc{animation:chomp2 .2s steps(1) infinite}
.pg{opacity:0;transition:transform .1s ease-out}
.pgi{transform-box:fill-box;transform-origin:50% 100%}
.pgy{fill:#7a7a7a;opacity:0;transition:opacity .25s}
.pcm.hunt .pgy{opacity:1}
.pacm.rest .pco{animation:none;opacity:1}
.pacm.rest .pcc{animation:none;opacity:0}
.pgi.dead{animation:gdie .9s forwards}
.pcm{touch-action:pan-y}
@keyframes show{from{opacity:0}to{opacity:1}}
@keyframes chomp{0%{opacity:1}50%{opacity:0}}
@keyframes chomp2{0%{opacity:0}50%{opacity:1}}
@keyframes gout{from{opacity:1}to{opacity:0}}
@keyframes gdie{0%{transform:none;filter:none;opacity:1}30%{transform:scale(1.1,.8);filter:grayscale(1)}100%{transform:scale(.3,.04);filter:grayscale(1);opacity:0}}
</style>
