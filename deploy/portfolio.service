[Unit]
Description=Sahas portfolio (Astro SSR)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/portfolio
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4321
# Secrets (RESEND_API_KEY, CONTACT_TO, CONTACT_FROM) live outside the releases so
# they survive every deploy.
EnvironmentFile=-/etc/portfolio.env
ExecStart=/usr/local/bin/node /var/www/portfolio/dist/server/entry.mjs
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
