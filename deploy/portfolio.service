[Unit]
Description=Sahas portfolio (Astro SSR)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/portfolio
Environment=NODE_ENV=production
# The box's IPv6 route to Cloudflare is unreliable, so try IPv4 addresses first.
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
Environment=HOST=127.0.0.1
Environment=PORT=4321
# Secrets live outside the releases so they survive every deploy. The mail token
# is written by the deploy workflow; the recipient/sender stay hand-managed.
EnvironmentFile=-/etc/portfolio.env
EnvironmentFile=-/etc/portfolio-mail.env
ExecStart=/usr/local/bin/node /var/www/portfolio/dist/server/entry.mjs
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
